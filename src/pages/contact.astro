---
import BaseLayout from '../layouts/BaseLayout.astro';
const mapSrc = 'https://www.google.com/maps?q=' + encodeURIComponent('경기도 화성시 마도면 청원로 136-18') + '&z=15&output=embed';
const naverSrc = 'https://map.naver.com/p/search/' + encodeURIComponent('경기도 화성시 마도면 청원로 136-18');
---
<BaseLayout
  title="연락처 | 케이비(주) KB Inc."
  description="케이비(주) 연락처와 오시는 길. 경기도 화성시 만세구 마도면 청원로 136-18 · 전화 031-357-4250 · kbi@kbinc.kr"
  active="contact"
>
  <section class="border-b border-hairline-steel relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-graphite-surface opacity-40 -skew-x-12 translate-x-1/3 pointer-events-none"></div>
    <div class="relative z-10 max-w-container mx-auto px-gutter pt-20 pb-16" data-reveal>
      <p class="font-mono text-[13px] text-arterial-red mb-4 flex items-center gap-3"><span class="w-8 h-px bg-arterial-red"></span>연락처 / CONTACT</p>
      <h1 class="font-display font-bold text-bright-alloy tracking-tightest text-[clamp(2.2rem,5vw,3.6rem)] leading-[1.1]">
        <span data-ko-only>제품·견적 문의</span><span data-en-only>Product &amp; quote inquiry</span>
      </h1>
      <p class="text-muted-zinc text-lg mt-5 max-w-2xl leading-relaxed">
        <span data-ko-only>전화 또는 이메일로 연락 주시면 담당자가 신속히 안내드립니다.</span>
        <span data-en-only>Call or email us — our team will get back to you promptly.</span>
      </p>
    </div>
  </section>

  <section class="border-b border-hairline-steel">
    <div class="max-w-container mx-auto px-gutter py-section-v">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10" data-reveal>
        <div>
          <p class="font-mono text-[13px] text-arterial-red mb-3">DIRECT</p>
          <h2 class="font-display font-bold text-3xl text-bright-alloy"><span data-ko-only>바로 연락하기</span><span data-en-only>Reach us directly</span></h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="tel:0313574250" class="inline-flex items-center gap-2 bg-arterial-red text-bright-alloy font-mono text-sm px-8 py-4 hover:bg-arterial-red-dim active:translate-y-px transition-all">
            <span class="material-symbols-outlined text-[18px]">call</span><span data-ko-only>전화 걸기</span><span data-en-only>CALL US</span>
          </a>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-8" data-reveal>
        <a href="tel:0313574250" class="border-t border-hairline-steel pt-4 group">
          <span class="font-mono text-[11px] tracking-[0.2em] text-muted-zinc block mb-2">TEL</span>
          <span class="font-mono text-lg text-bright-alloy group-hover:text-arterial-red transition-colors">031-357-4250</span>
        </a>
        <div class="border-t border-hairline-steel pt-4">
          <span class="font-mono text-[11px] tracking-[0.2em] text-muted-zinc block mb-2">FAX</span>
          <span class="font-mono text-lg text-bright-alloy">031-357-7250</span>
        </div>
        <a href="mailto:kbi@kbinc.kr" class="border-t border-hairline-steel pt-4 group">
          <span class="font-mono text-[11px] tracking-[0.2em] text-muted-zinc block mb-2">EMAIL</span>
          <span class="font-mono text-lg text-bright-alloy group-hover:text-arterial-red transition-colors">kbi@kbinc.kr</span>
        </a>
        <div class="border-t border-hairline-steel pt-4">
          <span class="font-mono text-[11px] tracking-[0.2em] text-muted-zinc block mb-2"><span data-ko-only>주소</span><span data-en-only>ADDRESS</span></span>
          <span class="text-[15px] text-bright-alloy leading-relaxed"><span data-ko-only>경기도 화성시 만세구 마도면 청원로 136-18<br />(청원리, 3동) 우18543</span><span data-en-only>Bldg #3, 136-18 Cheongwon-ro, Mado-myeon,<br />Manse-gu, Hwaseong-si, Gyeonggi-do, 18543 Korea</span></span>
        </div>
      </div>
    </div>
  </section>


  <!-- LOCATION MAP -->
  <section class="border-b border-hairline-steel">
    <div class="max-w-container mx-auto px-gutter py-section-v">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10" data-reveal>
        <div>
          <p class="font-mono text-[13px] text-arterial-red mb-3">LOCATION</p>
          <h2 class="font-display font-bold text-3xl text-bright-alloy"><span data-ko-only>찾아오시는 길</span><span data-en-only>Find us</span></h2>
        </div>
        <a href={naverSrc} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-hairline-steel text-muted-zinc font-mono text-[13px] px-6 py-3 hover:border-arterial-red hover:text-bright-alloy transition-colors self-start md:self-auto">
          <span class="material-symbols-outlined text-[16px]">map</span><span data-ko-only>지도 앱에서 보기</span><span data-en-only>OPEN IN MAP</span>
        </a>
      </div>
      <div class="border border-hairline-steel bg-graphite-surface overflow-hidden" data-reveal>
        <iframe
          title="케이비(주) 위치 지도"
          class="w-full h-[420px]"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={mapSrc}></iframe>
      </div>
    </div>
  </section>

</BaseLayout>
